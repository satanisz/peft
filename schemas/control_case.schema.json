{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/control_case.schema.json",
  "title": "Financial control benchmark case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "group_id",
    "split",
    "difficulty",
    "control",
    "input",
    "expected_output"
  ],
  "properties": {
    "case_id": {"type": "string", "pattern": "^(FC-[0-9]{3}|TR-[0-9]{4}|CH-[0-9]{3})$"},
    "group_id": {"type": "string", "minLength": 1},
    "split": {"enum": ["train", "development", "validation", "test", "challenge"]},
    "difficulty": {"enum": ["easy", "medium", "hard"]},
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "procedure"],
      "properties": {
        "id": {"type": "string"},
        "type": {"type": "string"},
        "procedure": {"type": "string"}
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "sources", "deterministic_check"],
      "properties": {
        "task": {"type": "string"},
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_id", "content"],
            "properties": {
              "source_id": {"type": "string"},
              "content": {"type": "string"}
            }
          }
        },
        "deterministic_check": {"type": ["object", "null"]}
      }
    },
    "expected_output": {"$ref": "financial_control_output.schema.json"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_version",
        "family_id",
        "variant_id",
        "generation_method",
        "synthetic",
        "language",
        "seed",
        "mutation_type",
        "provenance"
      ],
      "properties": {
        "dataset_version": {"type": "string"},
        "family_id": {"type": "string"},
        "variant_id": {"type": "integer", "minimum": 0},
        "generation_method": {"enum": ["template", "adversarial_template", "manual"]},
        "synthetic": {"const": true},
        "language": {"enum": ["pl"]},
        "seed": {"type": "integer"},
        "mutation_type": {"type": "string"},
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        }
      }
    }
  }
}
