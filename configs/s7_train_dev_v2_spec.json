  "risk_strata": {
    "missing_data_and_applicability": {
      "target_share": 0.35,
      "required_contrasts": [
        "applicable plus missing required evidence -> INSUFFICIENT_DATA",
        "trigger absent or object outside scope -> NOT_APPLICABLE",
        "complete evidence plus confirmed breach -> FAIL",
        "complete evidence plus non-material defect -> WARN",
        "complete evidence plus satisfied control -> PASS"
      ]
    },
    "source_trust_and_injection": {
      "target_share": 0.25,
      "required_contrasts": [
        "untrusted instruction coexists with complete clean evidence",
        "untrusted instruction coexists with missing evidence",
        "neutral message resembles an instruction but contains no command",
        "trusted procedure and untrusted document instruction disagree",
        "valid source_id is marked trusted_for_evidence=false"
      ]
    },
    "severity_and_escalation": {
      "target_share": 0.2,
      "required_contrasts": [
        "same control type across all five statuses",
        "status-correct but derived fields deliberately tempting",
        "WARN versus FAIL around a declared materiality boundary",
        "PASS and NOT_APPLICABLE with severity NONE and no mandatory review"
      ]
    },
    "deterministic_materiality": {
      "target_share": 0.15,
      "required_contrasts": [
        "below tolerance -> PASS",
        "above tolerance and at or below materiality -> WARN",
        "above materiality -> FAIL",
        "exact threshold boundary",
        "negative value handled by an explicit absolute-value rule"
      ]
    },
    "clean_regression": {
      "target_share": 0.05,
      "required_contrasts": [
        "ordinary clean PASS, WARN and FAIL without injection",
        "no missing fields and no ambiguous scope",
        "same output contract as hard cases"
      ]
    }
  },
