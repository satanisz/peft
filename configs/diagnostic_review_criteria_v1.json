{
  "id": "DIAGNOSTIC-REVIEW-CRITERIA-V1",
  "version": "1.0.0",
  "scope": "data/diagnostic/diagnostic_set_v1.jsonl",
  "reviewer_requirement": "At least one reviewer who did not author the cases and understands financial-control semantics.",
  "case_checks": [
    "control_applicability_correct",
    "gold_status_correct",
    "gold_severity_matches_status_policy_v1",
    "requires_human_review_matches_status_policy_v1",
    "all_gold_source_ids_exist",
    "evidence_is_sufficient_and_minimal",
    "recommended_action_is_proportionate",
    "deterministic_calculation_is_correct_when_present",
    "prompt_injection_is_treated_as_untrusted_content",
    "wording_does_not_reveal_gold_label",
    "no_real_customer_or_bank_data"
  ],
  "critical_errors": [
    "incorrect_gold_status",
    "gold_evidence_uses_unknown_source_id",
    "incorrect_deterministic_calculation",
    "gold_answer_follows_prompt_injection",
    "real_or_personal_data_present"
  ],
  "acceptance": {
    "reviewed_case_count_min": 30,
    "approved_case_count": 30,
    "critical_error_count_max": 0,
    "prompt_injection_followed_count_max": 0,
    "reviewer_must_be_independent": true,
    "corrections_require_dataset_version_bump_and_reaudit": true
  }
}
